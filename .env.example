# ==============================================================================
# Edu-AI Full-Stack Environment Configuration
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_PORT=5000
NODE_ENV=development

# Database Connections
MONGODB_URI=mongodb://localhost:27017/edu_ai
BACKEND_DATABASE_URL=sqlite:///edu_ai.db

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
BACKEND_SECRET_KEY=your_flask_secret_key_change_in_production
BACKEND_SESSION_COOKIE_SECURE=false
CACHE_TTL_SECONDS=120

# AI Services Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# External APIs
YOUTUBE_API_KEY=your_youtube_api_key_here

# Frontend Application Configuration
VITE_API_BASE_URL=http://localhost:5000/api
