# RuralAccess AI Backend Environment Variables

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database (SQLite by default)
DATABASE_URL=sqlite:///edu_ai.db

# Google Gemini API Key (for AI features)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Model (optional, defaults to gemini-flash-latest)
GEMINI_MODEL=models/gemini-flash-latest

# Session Configuration
SESSION_COOKIE_SECURE=false

# YouTube Cookies (optional, for restricted transcripts)
# YOUTUBE_COOKIES_PATH=./youtube_cookies.txt
