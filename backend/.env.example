# RuralAccess AI Backend Environment Variables

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database (SQLite by default)
DATABASE_URL=sqlite:///edu_ai.db

# ============================================
# GROQ API KEY (REQUIRED FOR AI TUTOR)
# ============================================
# Get your API key from: https://console.groq.com/keys
# Groq provides fast, reliable AI responses using open-source models
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override default Groq model
# Recommended models (as of 2026):
# - llama-3.3-70b-versatile (default, best reasoning and educational content)
# - llama-3.1-70b-versatile (good balance of speed and quality)
# - mixtral-8x7b-32768 (faster responses, good for quick queries)
# - gemma2-9b-it (lightweight and fast)
# GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# LEGACY: Google Gemini API (DEPRECATED)
# ============================================
# The system has been migrated to use Groq API
# These variables are no longer used but kept for reference:
# GEMINI_API_KEY=
# GEMINI_MODEL=models/gemini-flash-latest

# Session Configuration
SESSION_COOKIE_SECURE=false

# YouTube Cookies (optional, for restricted transcripts)
# YOUTUBE_COOKIES_PATH=./youtube_cookies.txt
