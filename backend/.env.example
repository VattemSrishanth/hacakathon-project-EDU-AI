# ==============================================================================
# LearnBridge AI / Edu-AI - Backend Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB for Node.js API services)
MONGODB_URI=mongodb://localhost:27017/edu_ai

# Python / Flask Engine Compatibility (Optional)
SECRET_KEY=your-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1
DATABASE_URL=sqlite:///edu_ai.db
SESSION_COOKIE_SECURE=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
CACHE_TTL_SECONDS=120

# ==============================================================================
# GROQ API CONFIGURATION (PRIMARY AI TUTOR ENGINE)
# ==============================================================================
# Generate your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Recommended Groq Models:
# - llama-3.3-70b-versatile (Recommended default: best reasoning & educational responses)
# - llama-3.1-70b-versatile (Fast and balanced)
# - mixtral-8x7b-32768 (Low latency for quick inquiries)
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# GOOGLE GEMINI API (FALLBACK AI ENGINE)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# EXTERNAL INTEGRATIONS
# ==============================================================================
# YouTube Data API v3 (for syllabus video recommendations and transcripts)
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube Cookies file path (optional, for restricted educational transcripts)
# YOUTUBE_COOKIES_PATH=./youtube_cookies.txt

# ==============================================================================
# DEV SEED CREDENTIALS (CUSTOMIZE OR LEAVE BLANK FOR DEFAULTS)
# ==============================================================================
STUDENT_EMAIL=student@eduai.com
STUDENT_PASSWORD=student123

TEACHER_EMAIL=teacher@eduai.com
TEACHER_PASSWORD=teacher123

PARENT_EMAIL=parent@eduai.com
PARENT_PASSWORD=parent123

ADMIN_EMAIL=admin@eduai.com
ADMIN_PASSWORD=admin123
